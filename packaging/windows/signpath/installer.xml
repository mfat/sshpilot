<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the Windows installer. The copy that
  counts is the one uploaded to the SignPath project; keep the two in step.

  actions/upload-artifact zips what it uploads, so the root is a zip holding
  the single NSIS setup exe built by build.ps1 -Installer.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="SSHPilot-*-setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
