# Python
__pycache__/
*.pyc
*.egg-info/

# Virtual environments
venv/
.venv*/
/.venv-system
/.venv-system-python
.venv-homebrew/

# Build output
/dist
/build
# AppImage build output (packaging/appimage/build-appimage.sh, CI writes here too)
/release-assets
builddir/
/artifacts

# Flatpak build. flatpak/ holds the tracked copy of the Flathub manifest; the
# root manifest is generated from it for local builds
# (scripts/flatpak-dev-manifest.py, run by scripts/test-flatpak.sh).
/io.github.mfat.sshpilot.yaml
/.flatpak-builder
/repo

# Debian build artifacts (debian/ packaging itself is tracked for the PPA).
# dpkg-buildpackage builds in obj-<arch> and stages into debian/<package>/.
build-deb-local.sh
/obj-*
/debian/.debhelper/
/debian/files
/debian/sshpilot/
/debian/*.substvars
/debian/*.debhelper
/debian/debhelper-build-stamp

# Test output
*.log
.pytest_cache/
.ruff_cache/
.codebase-memory/

# Local assistant/editor instructions (not published)
CLAUDE.md
AGENTS.md

# Editors / tools
.history/
.cursor/
.vscode/
.claude/
.DS_Store
whip.md
# Local notes for the non-SSH protocol rig and e2e runs (kept out of the repo;
# the rig itself lives in ~/sshpilot-authrig).
PROTOCOL_RIG.md
scripts/generate_github_url.sh
scripts/screenshot_url.sh
gnome-settings/gnome-control-center/

# Generated files
sshpilot/vendor/pyxtermjs/index.html

# Plugin sources live in their own repos / the registry and are fetched at
# runtime — they are not shipped from this repo. (Anchored so it never matches
# the sshpilot/plugins/ code package.)
/plugins/
/.mimocode

# Generated translation template
po/*.pot
/.commandcode

# graphify knowledge-graph output (regenerable; ~50MB)
graphify-out/

# Local agent terminal investigation artifacts
.agent_terminal_investigation/


# Microsoft.Windows.Console.ConPTY NuGet download (conpty.dll + OpenConsole.exe,
# see docs/architecture/windows-port.md). Never committed.
/vendor/conpty/
# Patched libvterm built by packaging/windows/libvterm/build.py. Never committed.
/vendor/libvterm/
# libghostty-vt built by packaging/windows/libghostty-vt/build.py, and its
# pinned downloads (Zig, release tarballs). Never committed.
/vendor/libghostty-vt/
/vendor/.cache/
# gvsbuild GTK 4 runtime fetched by scripts/fetch-gtk.py. Never committed.
/vendor/gtk/
/vendor/GTK4_Gvsbuild_*.zip
/vendor/gtk4-frdp-*.zip
/vendor/*.part

# Meson subproject lock file (created by meson setup)
/subprojects/.wraplock
