using Gtk 4.0;
using Adw 1;

// The Settings window. Layout skeleton only: sidebar rows and preference pages
// are built in preferences.py (add_page_to_layout). This file owns the window,
// the NavigationSplitView / ToolbarView / HeaderBar / ScrolledWindow structure
// and the collapse breakpoint.
//
// A separate, non-modal Adw.Window, transient for its main window (set in
// show_preferences) so it stays above it: the main window stays usable so
// font, color and sidebar changes can be watched live. Dialogs opened from
// Settings are presented on this window (see PreferencesWindow._dialog_parent).
template $SshPilotPreferencesWindow: Adw.Window {
  title: _("Settings");
  default-width: 960;
  default-height: 720;
  // Breakpoints need an explicit minimum; match a usable phone-ish width so
  // the collapsed list↔detail flow still lays out.
  width-request: 360;
  height-request: 200;

  Adw.Breakpoint {
    // Sidebar + content need ~628sp side by side; below that, collapse into
    // NavigationSplitView's internal NavigationView (list then detail).
    condition ("max-width: 628sp")

    setters {
      split_view.collapsed: true;
    }
  }

  // Settings covers part of its main window, so toasts meant for whatever the
  // user is looking at land here while it is shown (add_toast, and the
  // pre-connection alert routing in main.py).
  content: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationSplitView split_view {
      min-sidebar-width: 180;
      max-sidebar-width: 280;
      sidebar-width-fraction: 0.25;

      sidebar: Adw.NavigationPage sidebar_page {
        title: _("Settings");
        tag: "prefs-sidebar";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar sidebar_header_bar {
            show-end-title-buttons: false;

            [end]
            Gtk.ToggleButton search_button {
              icon-name: "system-search-symbolic";
              tooltip-text: _("Search Settings");
            }

            styles [
              "flat",
            ]
          }

          // Search matches individual settings, not just pages; results
          // replace the category list (see setup_settings_search).
          [top]
          Gtk.SearchBar search_bar {
            search-mode-enabled: bind search_button.active bidirectional;

            child: Gtk.SearchEntry search_entry {
              placeholder-text: _("Search settings");
              hexpand: true;
            };
          }

          content: Gtk.Stack sidebar_stack {
            Gtk.StackPage {
              name: "pages";

              child: Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vscrollbar-policy: automatic;

                Gtk.ListBox sidebar {
                  selection-mode: single;
                  activate-on-single-click: true;

                  styles [
                    "navigation-sidebar",
                  ]
                }
              };
            }

            Gtk.StackPage {
              name: "results";

              child: Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vscrollbar-policy: automatic;

                Gtk.ListBox search_results {
                  selection-mode: single;
                  activate-on-single-click: true;

                  styles [
                    "navigation-sidebar",
                  ]
                }
              };
            }

            Gtk.StackPage {
              name: "empty";

              child: Adw.StatusPage {
                icon-name: "system-search-symbolic";
                title: _("No Results");

                styles [
                  "compact",
                ]
              };
            }
          };
        };
      };

      content: Adw.NavigationPage content_page {
        title: _("Settings");
        tag: "prefs-content";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar header_bar {
            show-start-title-buttons: false;

            styles [
              "flat",
            ]
          }

          content: Gtk.ScrolledWindow {
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;

            Gtk.Stack content_stack {
              hexpand: true;
              vexpand: true;
              transition-type: crossfade;
            }
          };
        };
      };
    };
  };
}
