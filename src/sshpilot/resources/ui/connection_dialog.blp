using Gtk 4.0;
using Adw 1;

// Layout skeleton only, laid out like the Settings window: a sidebar of
// sections beside the selected page. The sidebar rows and the pages
// (content_stack) are built in Python (connection_dialog.py:
// _build_connection_tab_pages / _build_sidebar_navigation); this file owns the
// split view, the header bars (Cancel / Save on the page's), and the Advanced
// Configuration button at the foot of the sidebar.
template $ConnectionDialog: Adw.Window {
  modal: true;
  default-width: 880;
  default-height: 680;
  // Breakpoints need an explicit minimum size.
  width-request: 360;
  height-request: 400;

  // No setters: below this width _sync_split_layout collapses the split view
  // into list -> page navigation. It also collapses it when a protocol leaves
  // a single page, so that one page shows without a sidebar.
  Adw.Breakpoint narrow_breakpoint {
    condition ("max-width: 640sp")
  }

  content: Adw.NavigationSplitView split_view {
    min-sidebar-width: 190;
    max-sidebar-width: 260;
    // Wide enough for "Advanced Configuration" on one line.
    sidebar-width-fraction: 0.29;

    sidebar: Adw.NavigationPage sidebar_page {
      title: _("Connection");
      tag: "connection-sidebar";

      child: Adw.ToolbarView {
        // The dialog's title and the search button, as in the Settings
        // window: the sidebar is too narrow for a text button besides.
        [top]
        Adw.HeaderBar {
          show-end-title-buttons: false;

          [end]
          Gtk.ToggleButton search_button {
            icon-name: "system-search-symbolic";
            tooltip-text: _("Search");
          }
        }

        // Search matches the fields on every page; results replace the
        // section list (connection_dialog_search.py).
        [top]
        Gtk.SearchBar search_bar {
          search-mode-enabled: bind search_button.active bidirectional;

          child: Gtk.SearchEntry search_entry {
            placeholder-text: _("Search");
            hexpand: true;
          };
        }

        content: Gtk.Stack sidebar_stack {
          Gtk.StackPage {
            name: "pages";

            child: Gtk.ScrolledWindow {
              hscrollbar-policy: never;
              vscrollbar-policy: automatic;

              Gtk.ListBox sidebar_list {
                selection-mode: single;
                activate-on-single-click: true;

                styles [
                  "navigation-sidebar",
                ]
              }
            };
          }

          Gtk.StackPage {
            name: "results";

            child: Gtk.ScrolledWindow {
              hscrollbar-policy: never;
              vscrollbar-policy: automatic;

              Gtk.ListBox search_results {
                selection-mode: single;
                activate-on-single-click: true;

                styles [
                  "navigation-sidebar",
                ]
              }
            };
          }

          Gtk.StackPage {
            name: "empty";

            child: Adw.StatusPage {
              icon-name: "system-search-symbolic";
              title: _("No Results");

              styles [
                "compact",
              ]
            };
          }
        };

        // About the SSH configuration as a whole rather than one page, so
        // it stays put while the pages change. A row of the same kind as
        // the sections above, so it has their size and their type.
        [bottom]
        Gtk.ListBox config_buttons_box {
          selection-mode: none;
          activate-on-single-click: true;

          styles [
            "navigation-sidebar",
          ]

          Adw.ActionRow advanced_config_button {
            title: _("Advanced Configuration");
            tooltip-text: _("Show this host's block among the blocks that apply to it");
            activatable: true;

            [prefix]
            Gtk.Image {
              icon-name: "document-properties-symbolic";
            }
          }
        }
      };
    };

    content: Adw.NavigationPage content_page {
      title: _("Connection");
      tag: "connection-content";

      child: Adw.ToolbarView {
        // Cancel and Save on either side of the title, as in other GNOME
        // dialogs; Cancel (and Escape) stands in for the close button.
        [top]
        Adw.HeaderBar {
          show-start-title-buttons: false;
          show-end-title-buttons: false;

          // Title: the page; subtitle: what the connection reaches
          // (user@host:port), kept current by _update_content_title.
          title-widget: Adw.WindowTitle content_title {
            title: _("Connection");
          };

          [start]
          Gtk.Button cancel_button {
            label: _("Cancel");
          }

          [end]
          Gtk.Button save_button {
            label: _("Save");

            styles [
              "suggested-action",
            ]
          }
        }

        // Banners (read-only config, overridden settings) are prepended
        // here, above the pages.
        content: Gtk.Box content_mount {
          orientation: vertical;
          vexpand: true;

          Gtk.Stack content_stack {
            vexpand: true;
            hexpand: true;
            transition-type: crossfade;
          }
        };
      };
    };
  };
}
