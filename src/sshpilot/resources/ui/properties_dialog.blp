using Gtk 4.0;
using Adw 1;

template $SshPilotPropertiesDialog: Adw.Window {
  title: _("Properties");
  default-width: 400;
  default-height: 500;
  resizable: true;
  modal: true;

  content: Adw.NavigationView navigation_view {
    Adw.NavigationPage {
      title: _("Properties");
      tag: "properties";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        content: Gtk.ScrolledWindow {
          hscrollbar-policy: never;
          propagate-natural-height: true;

          child: Gtk.Box content_box {
            orientation: vertical;
            spacing: 16;
            margin-top: 16;
            margin-bottom: 16;
            margin-start: 16;
            margin-end: 16;
          };
        };
      };
    }
  };
}
