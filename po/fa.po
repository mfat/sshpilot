#: data/io.github.mfat.sshpilot.metainfo.xml.in:788
msgid "- Added support for Wake on Lan"
msgstr "- افزودن پشتیبانی از Wake on Lan"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:789
msgid "- Added pre-connection command support"
msgstr "- افزودن پشتیبانی از دستور پیش از اتصال"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:795
msgid "- Minor bug fixes"
