#: src/sshpilot/window_dialogs.py:551
msgid "Verification code"
msgstr "کد تأیید"

#: src/sshpilot/window_dialogs.py:556 src/sshpilot/window_dialogs.py:597
msgid "Store password"
msgstr "ذخیرهٔ گذرواژه"

#: src/sshpilot/window_dialogs.py:615
msgid ""
"Secret storage is set to SSH Agent Only — passwords and passphrases are not "
"saved by SSH Pilot."
msgstr ""
"ذخیره‌سازی راز روی «تنها ssh-agent» تنظیم شده است — گذرواژه‌ها و عبارت‌های عبور "
"توسط SSH Pilot ذخیره نمی‌شوند."

#: src/sshpilot/window_dialogs.py:629
msgid "Remember until SSH Pilot quits"
msgstr ""

#: src/sshpilot/window_dialogs.py:734
msgid "Known hosts unavailable"
msgstr "known_hosts در دسترس نیست"

#: src/sshpilot/window_dialogs.py:735
msgid "Connect to the SSH Pilot daemon before editing known hosts."
msgstr "پیش از ویرایش known_hosts به دیمن SSH Pilot متصل شوید."

#: src/sshpilot/window_dialogs.py:837
msgid "No SSH connections selected"
msgstr "هنوز اتصالی وجود ندارد"

#: src/sshpilot/window_dialogs.py:906
#, python-brace-format
msgid ""
"{connection} was detached from login profile “{profile}” because its SSH "
"config was edited."
msgstr ""
"{connection} از نمایه ورود «{profile}» جدا شد زیرا پیکربندی SSH آن ویرایش "
"شده بود."

#: src/sshpilot/window_dialogs.py:1039
msgid "Start Backup"
msgstr "برون‌ریزی پشتیبان"

#: src/sshpilot/window_dialogs.py:1076
msgid ""
"A backup lets you move everything to a new system, or restore it after a "
"reinstall. It includes your connections, groups, app settings, known hosts "
"and saved passwords."
msgstr ""
"یک نسخهٔ پشتیبان به شما امکان می‌دهد همه چیز را به یک سیستم جدید منتقل کرده یا "
"پس از نصب مجدد بازیابی کنید. این نسخه شامل اتصالات، گروه‌ها، تنظیمات برنامه، "
"میزبان‌های شناخته‌شده و گذرواژه‌های ذخیره‌شدهٔ شما است."

#. -- destination -------------------------------------------------
#: src/sshpilot/window_dialogs.py:1102
msgid "Where should it go?"
msgstr "کجا ذخیره شود؟"

#: src/sshpilot/window_dialogs.py:1137
msgid "Backup to file"
msgstr "پشتیبان‌گیری/بازیابی"

#: src/sshpilot/window_dialogs.py:1138
msgid ""
"One .spbk file you choose the folder for. Good for a USB stick or your own "
"cloud drive."
msgstr ""
"یک فایل spbk. که پوشهٔ آن را خودتان انتخاب می‌کنید. مناسب برای فلش‌مموری یا "
"فضای ابری شخصی شما."

#: src/sshpilot/window_dialogs.py:1142
msgid "Bitwarden vault"
msgstr "وضعیت Bitwarden"

#: src/sshpilot/window_dialogs.py:1143
msgid ""
"Saved as a secure note in your vault. Your Bitwarden account already "
"encrypts it, so there is no extra passphrase to remember."
msgstr ""
"به‌عنوان یک یادداشت امن در گاوصندوق شما ذخیره شد. حساب Bitwarden شما قبلاً آن "
"را رمزنگاری کرده است، بنابراین نیازی به به‌خاطرسپاری عبارت عبور اضافی نیست."

#: src/sshpilot/window_dialogs.py:1147
msgid "One of your servers"
msgstr "ابتدا به سرور خود متصل شوید!"

#: src/sshpilot/window_dialogs.py:1148
msgid ""
"Uploaded over SFTP to a host from your inventory. Always protected with a "
"passphrase."
msgstr ""
"از طریق SFTP در میزبانی از فهرست موجودی شما بارگذاری شد. همیشه با یک عبارت "
"عبور محافظت می‌شود."

#: src/sshpilot/window_dialogs.py:1166 src/sshpilot/window_dialogs.py:2506
msgid "Selected server"
msgstr "سرور انتخاب‌شده"

#: src/sshpilot/window_dialogs.py:1204 src/sshpilot/window_dialogs.py:2448
#: src/sshpilot/window_dialogs.py:2511
msgid "No servers"
msgstr "بدون سرور"

#: src/sshpilot/window_dialogs.py:1229
msgid "Protect the backup with a passphrase"
msgstr "رمزنگاری با یک عبارت عبور"

#: src/sshpilot/window_dialogs.py:1236
msgid ""
"Bitwarden encrypts the backup with your vault credentials, so no separate "
"passphrase is needed."
msgstr "برنامهٔ Bitwarden پشتیبان را با اطلاعات اعتبار خزنه‌تان رمزنگاری می‌کند."

#: src/sshpilot/window_dialogs.py:1248
msgid "Also copy saved secrets as Bitwarden login items"
msgstr "همچنین رونوشت رمزهای ذخیره‌شده به عنوان موارد ورود Bitwarden"

#: src/sshpilot/window_dialogs.py:1249
msgid ""
"Creates normal login entries in your vault in addition to the backup note."
msgstr ""
"علاوه بر یادداشت پشتیبان، ورودی‌های ورود عادی را در خزنه‌تان ایجاد می‌کند."

#: src/sshpilot/window_dialogs.py:1257
msgid "Include your private key files"
msgstr "فایل‌های کلید خصوصی"

#: src/sshpilot/window_dialogs.py:1258
msgid ""
"Copies the keys themselves out of ~/.ssh. Leave this off unless the new "
"machine needs them."
msgstr ""
"خود کلیدها را از مسیر ssh/.~ کپی می‌کند. این گزینه را خاموش بگذارید مگر اینکه "
"دستگاه جدید به آن‌ها نیاز داشته باشد."

#: src/sshpilot/window_dialogs.py:1275
msgid ""
"Without a passphrase your keys and saved passwords are written in plain text "
"— anyone who opens the file can read them."
msgstr ""
"بدون عبارت عبور، کلیدها و گذرواژه‌های ذخیره‌شدهٔ شما به‌صورت متن آشکار نوشته "
"می‌شوند — هر کسی فایل را باز کند می‌تواند آن‌ها را بخواند."

#: src/sshpilot/window_dialogs.py:1321
msgid ""
"Required for a server upload. You will be asked for the passphrase when the "
"export starts."
msgstr "هنگام ذخیرهٔ پشتیبان، از شما خواسته می‌شود عبارت عبور را وارد کنید."

#: src/sshpilot/window_dialogs.py:1325
msgid ""
"You will be asked for a passphrase when the export starts. Keep it somewhere "
"safe — it cannot be recovered."
msgstr "هنگام ذخیرهٔ پشتیبان، از شما خواسته می‌شود عبارت عبور را وارد کنید."

#: src/sshpilot/window_dialogs.py:1329
msgid ""
"Off: saved passwords are written in plain text and readable by anyone with "
"the file."
msgstr ""
"خاموش: گذرواژه‌های ذخیره‌شده به‌صورت متن آشکار نوشته شده و توسط هر کسی که فایل "
"را داشته باشد قابل خواندن هستند."

#: src/sshpilot/window_dialogs.py:1341
msgid ""
"The backup is stored as a secure note named after today's date. Importing it "
"later asks for your vault, not a passphrase."
msgstr ""
"نسخهٔ پشتیبان به‌عنوان یک یادداشت امن به نام تاریخ امروز ذخیره می‌شود. درون‌ریزی "
"بعدی آن از شما گاوصندوق را می‌خواهد، نه عبارت عبور را."

#: src/sshpilot/window_dialogs.py:1345
msgid ""
"The file is uploaded over your existing SSH connection. Nothing is left "
"behind on this computer."
msgstr ""
"فایل از طریق اتصال SSH فعلی شما بارگذاری می‌شود. هیچ ردی روی این رایانه باقی "
"نمی‌ماند."

#: src/sshpilot/window_dialogs.py:1348
msgid "You will pick the folder and file name next."
msgstr "در مرحلهٔ بعد پوشه و نام فایل را انتخاب خواهید کرد."

#: src/sshpilot/window_dialogs.py:1402
msgid "Choose a server to back up to."
msgstr "سروری را برای پشتیبان‌گیری انتخاب کنید."

