#: data/io.github.mfat.sshpilot.metainfo.xml.in:649
msgid ""
"- New \"Splt View\" feature - view terminals side by side inside any "
"terminal tab"
msgstr ""
"- Новая функция «Разделенный вид» — просмотр терминалов рядом друг с другом "
"на любой вкладке"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:650
msgid "- New context menu item to copy host address"
msgstr "- Новый пункт контекстного меню для копирования адреса хоста"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:656
msgid "- Updated flatpak to GNOME Platform 50"
msgstr "- Пакет Flatpak обновлен до платформы GNOME 50"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:662
msgid "- Added URL support to terminal"
msgstr "- В терминал добавлена поддержка URL-адресов"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:675
msgid "- Fixes for Quick Connect function"
msgstr "- Исправления для функции быстрого подключения"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:676
msgid "- Add option to save Quick Connect host"
msgstr "- Добавлена возможность сохранения хоста быстрого подключения"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:677
msgid ""
"- Added option to rename a tab - Double-click any terminal tab to rename"
msgstr ""
"- Добавлена возможность переименования вкладки: дважды щелкните по любой "
"вкладке терминала для переименования"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:678
msgid "- Added support for Wake on Lan"
msgstr "- Добавлена поддержка Wake-on-LAN"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:679
msgid "- Added pre-connection command support"
msgstr "- Добавлена поддержка команд перед подключением"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:685
msgid "- Minor bug fixes"
msgstr "- Небольшие исправления ошибок"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:697
msgid "- Fixed saved secrets not used for login"
msgstr ""
"- Исправлена ошибка, из-за которой сохраненные секреты не использовались для "
"входа"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:703
msgid "- Support for sidebar resizing"
msgstr "- Поддержка изменения размера боковой панели"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:704
