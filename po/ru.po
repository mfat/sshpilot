#: data/io.github.mfat.sshpilot.metainfo.xml.in:580
msgid "- Updated color badges"
msgstr "- Обновлены цветные значки"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:581
msgid "- Various bug fixes and UI improvements"
msgstr "- Различные исправления ошибок и улучшения интерфейса"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:593
msgid "- Added option to resize sidebar"
msgstr "- Добавлена возможность изменения размера боковой панели"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:594
msgid "- Fixed long host values making sidebar too wide"
msgstr "- Исправлено излишнее расширение боковой панели из-за длинных значений хостов"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:595
msgid "- Bug fixes and UI improvements"
msgstr "- Исправления ошибок и улучшения интерфейса"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:601
msgid "- Drag and drop files and folders on terminal to upload via SCP"
msgstr "- Перетаскивание файлов и папок в терминал для отправки через SCP"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:613
#: data/io.github.mfat.sshpilot.metainfo.xml.in:622
msgid "- Make terminal fullscreen with F11"
msgstr "- Переход терминала в полноэкранный режим по клавише F11"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:614
msgid "- Improvements for SCP file transfers"
msgstr "- Улучшения передачи файлов по SCP"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:615
msgid "- Drag and drop files and folders directly on terminal widget"
msgstr "- Перетаскивание файлов и папок прямо на виджет терминала"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:616
msgid "- Updated password/passphrase prompts with option to store secrets"
msgstr "- Обновлены запросы пароля/парольной фразы с возможностью сохранения секретов"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:623
msgid "- Added xterm.js as an alternative terminal backend"
msgstr "- Добавлен xterm.js в качестве альтернативного движка терминала"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:624
msgid "- Added graphical prompts for passwords/passphrases"
msgstr "- Добавлены графические запросы паролей и парольных фраз"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:636
msgid "- Fixed black toolbar in file manager"
msgstr "- Исправлена черная панель инструментов в диспетчере файлов"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:637
msgid "- Fixed nano editor issue when run under KDE Plasma desktop"
msgstr "- Исправлена проблема с редактором nano при работе в окружении KDE Plasma"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:643
msgid "- Enhanced text editor for built-in file manager"
msgstr "- Улучшенный текстовый редактор для встроенного диспетчера файлов"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:649
msgid "- Bug fixes for SFTP file manager"
msgstr "- Исправления ошибок в диспетчере файлов SFTP"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:655
msgid "- Improvements to built-in file manager, new text editor"
msgstr "- Улучшения во встроенном диспетчере файлов, новый текстовый редактор"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:656
msgid "- Added file mmanager button to connection rows"
msgstr "- В строки подключений добавлена кнопка диспетчера файлов"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:657
msgid "- Sort button now sorts groups too"
msgstr "- Кнопка сортировки теперь упорядочивает и группы"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:663
msgid "- Fixed file manager bug when password authentication is selected"
msgstr "- Исправлена ошибка диспетчера файлов при выборе аутентификации по паролю"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:669
msgid "- Redesigned start page, with card and list layouts"
msgstr "- Обновлена начальная страница с макетами в виде карточек и списка"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:670
msgid "- Minor UI fixes"
msgstr "- Небольшие исправления интерфейса"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:676
msgid "- Update notifier fixes"
msgstr "- Исправления в уведомлениях об обновлениях"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:688
msgid "- Added update notifier"
msgstr "- Добавлены уведомления об обновлениях"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:694
msgid "- New feature: Import/Export configuration"
msgstr "- Новая возможность: импорт и экспорт конфигурации"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:695
msgid "- Better log output"
msgstr "- Улучшен вывод журнала"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:701
msgid "Added sorting to connection list"
msgstr "Добавлена сортировка списка подключений"

