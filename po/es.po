#: data/io.github.mfat.sshpilot.metainfo.xml.in:480
#: data/io.github.mfat.sshpilot.metainfo.xml.in:490
msgid "Better look and feel for built-in file manager"
msgstr "Mejor apariencia para el administrador de archivos integrado"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:481
msgid "Zoom control for file manager"
msgstr "Control de zoom para administrador de archivos"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:482
msgid "New option to always show Commands sidebar"
msgstr "Nueva opción para mostrar siempre la barra lateral de Comandos"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:483
msgid "More reliable SFTP file transfers"
msgstr "Transferencias de archivos SFTP más confiables"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:484
msgid "Changed default connection list shortcut to Ctrl+Shift+L"
msgstr "Se cambió el acceso directo de la lista de conexiones predeterminada a Ctrl+Shift+L"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:500
msgid "Introducing Command Blocks - Organize your favorite commands in folders, insert them into terminal with a simple double-click"
msgstr "Presentamos bloques de comandos: organice sus comandos favoritos en carpetas, insértelos en la terminal con un simple doble clic"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:501
msgid "Choose a command from your command snippet intventory to run on a single host or a group of machines"
msgstr "Elija un comando de su inventario de fragmentos de comando para ejecutarlo en un único host o en un grupo de máquinas"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:502
msgid "More improvements to Split View"
msgstr "Más mejoras en la vista dividida"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:507
msgid "New \"Sessions\" feature — Save, open, rename, and delete snapshots of your open tabs and restore them automatically"
msgstr "Nueva función \"Sesiones\": guarde, abra, cambie el nombre y elimine instantáneas de sus pestañas abiertas y restáurelas automáticamente"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:508
msgid "Pin saved sessions to the start page for one-click restore"
msgstr "Fije sesiones guardadas a la página de inicio para restaurarlas con un solo clic"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:509
msgid "Copy to group — Add a connection to another group without removing it from its current group(s). Same connection can appear in multiple groups."
msgstr "Copiar a grupo: agrega una conexión a otro grupo sin eliminarla de sus grupos actuales. La misma conexión puede aparecer en varios grupos."

#: data/io.github.mfat.sshpilot.metainfo.xml.in:510
msgid "Jump host picker — Pick jump hosts from your saved connections when editing a connection."
msgstr "Selector de host de salto: elija hosts de salto de sus conexiones guardadas al editar una conexión."

#: data/io.github.mfat.sshpilot.metainfo.xml.in:511
msgid "Better Split View - Resize terminal panes freely, drag and drop an entire group onto a Split View"
msgstr "Mejor vista dividida: cambie el tamaño de los paneles del terminal libremente, arrastre y suelte un grupo completo en una vista dividida"

