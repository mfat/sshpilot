msgid "Added option to reveal scp-downloaded files in file manager"
msgstr ""
"Se agregó una opción para abrir una terminal en las pestañas del "
"administrador de archivos."

#: data/io.github.mfat.sshpilot.metainfo.xml.in:190
msgid "Fixed backup decryption bug during restore"
msgstr "Se solucionó el problema de cifrado de respaldo"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:200
msgid ""
"Introducing \"Host Info\" - detailed info about any host, available from the "
"context menu"
msgstr ""
"Presentación de «Información del host»: información detallada sobre "
"cualquier host, disponible desde el menú contextual"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:201
msgid ""
"New languages: Spanish, Portuguese, Brazilian Portuguese, Chinese, Russian "
"and Persian"
msgstr ""
"Nuevos idiomas: español, portugués, portugués de Brasil, chino, ruso y persa"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:216
#: data/io.github.mfat.sshpilot.metainfo.xml.in:222
