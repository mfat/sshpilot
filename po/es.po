#: data/io.github.mfat.sshpilot.metainfo.xml.in:8
msgid "Manage your servers with ease"
msgstr "Administre sus servidores con facilidad"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:10
msgid ""
"SSH Pilot is a user-friendly SSH connection manager featuring built-in "
"tabbed terminal, remote file management, key transfer, port forwarding and "
"more. It's an alternative to Putty, Termius and Mobaxterm."
msgstr ""
"SSH Pilot es un administrador de conexiones SSH fácil de usar que incluye "
"terminal con pestañas incorporado, administración remota de archivos, "
"transferencia de claves, reenvío de puertos y más. Es una alternativa a "
"Putty, Termius y Mobaxterm."

#: data/io.github.mfat.sshpilot.metainfo.xml.in:12
msgid "Manage multiple machines from a unified, clean interface"
msgstr "Administre múltiples máquinas desde una interfaz limpia y unificada"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:13
msgid ""
"Transfer files to and from servers using the built-in file manager (SFTP and "
"SCP)"
msgstr ""
"Transfiera archivos hacia y desde servidores utilizando el administrador de "
"archivos integrado (SFTP y SCP)"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:14
msgid "Tuned for fast keyboard navigation with customizable shortcuts"
msgstr ""
"Optimizado para una navegación rápida con el teclado con atajos "
"personalizables"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:15
msgid "Easily generate and transfer SSH keys to servers"
msgstr "Genere y transfiera fácilmente claves SSH a servidores"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:16
msgid ""
"Loads existing ~/.ssh/config and works with standard SSH keys and settings"
msgstr ""
"Carga ~/.ssh/config existente y funciona con claves y configuraciones SSH "
"estándar"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:17
msgid "Configure local, remote and dynamic port forwarding"
msgstr "Configurar el reenvío de puertos local, remoto y dinámico"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:18
msgid "Server grouping"
msgstr "Agrupación de servidores"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:30
msgid "mFat"
msgstr "mGrasa"

