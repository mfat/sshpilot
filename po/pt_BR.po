#: data/io.github.mfat.sshpilot.metainfo.xml.in:8
msgid "Manage your servers with ease"
msgstr "Gerencie seus servidores com facilidade"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:10
msgid ""
"SSH Pilot is a user-friendly SSH connection manager featuring built-in "
"tabbed terminal, remote file management, key transfer, port forwarding and "
"more. It's an alternative to Putty, Termius and Mobaxterm."
msgstr ""
"O SSH Pilot é um gerenciador de conexões SSH amigável que conta com terminal "
"integrado com abas, gerenciamento de arquivos remotos, transferência de "
"chaves, redirecionamento de portas e muito mais. É uma alternativa ao PuTTY, "
"Termius e MobaXterm."

#: data/io.github.mfat.sshpilot.metainfo.xml.in:12
msgid "Manage multiple machines from a unified, clean interface"
msgstr "Gerencie várias máquinas a partir de uma interface limpa e unificada"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:13
msgid ""
"Transfer files to and from servers using the built-in file manager (SFTP and "
"SCP)"
msgstr ""
"Transfira arquivos de e para servidores usando o gerenciador de arquivos "
"integrado (SFTP e SCP)"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:14
msgid "Tuned for fast keyboard navigation with customizable shortcuts"
msgstr ""
"Ajustado para navegação rápida pelo teclado com atalhos personalizáveis"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:15
msgid "Easily generate and transfer SSH keys to servers"
msgstr "Gere e transfira facilmente chaves SSH para servidores"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:16
msgid ""
"Loads existing ~/.ssh/config and works with standard SSH keys and settings"
msgstr ""
"Carrega o ~/.ssh/config existente e funciona com chaves e configurações SSH "
"padrão"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:17
msgid "Configure local, remote and dynamic port forwarding"
msgstr "Configure redirecionamento de portas local, remoto e dinâmico"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:18
msgid "Server grouping"
msgstr "Agrupamento de servidores"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:30
msgid "mFat"
msgstr "mFat"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:66
msgid "More SFTP improvemnets"
msgstr "Pequenas melhorias na interface"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:67
msgid "Added support for OSC 52"
msgstr "Adicionado suporte para grupos aninhados"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:72
msgid "Various improvemnets to SFTP file manager"
msgstr "Melhorias de desempenho no gerenciador de arquivos SFTP"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:73
#: data/io.github.mfat.sshpilot.metainfo.xml.in:251
msgid "Minor bug fixes"
msgstr "Pequenas correções de bugs"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:78
msgid ""
"Fixed KeePass database creation failing with a false \"pykeepass is not "
"installed\" error"
msgstr ""
