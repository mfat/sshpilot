msgid "Updated port forwarding indicators"
msgstr "Indicadores de redirecionamento de portas atualizados"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:692
msgid "New sidebar behavior options — configure autohide from Settings"
msgstr ""
"Novas opções de comportamento da barra lateral — configure a ocultação "
"automática nas Configurações"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:693
msgid "Improvements to Split View"
msgstr "Melhorias na visualização dividida"

#: data/io.github.mfat.sshpilot.metainfo.xml.in:694
msgid "Added local terminal button to the headerbar"
msgstr "Adicionado botão de terminal local à barra de cabeçalho"

