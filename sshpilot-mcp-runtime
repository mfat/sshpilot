#!/usr/bin/env python3
"""sshPilot runtime MCP server launcher (stdio).

Talks to a running sshpilotd via DaemonClient. Enable access in
Preferences ▸ AI Assistants first, then register this script in the AI client.

    pip install 'sshpilot[mcp]'
"""

import os
import sys

_script_dir = os.path.dirname(os.path.abspath(__file__))
_src_path = os.path.join(_script_dir, "src")
if os.path.isdir(_src_path):
    sys.path.insert(0, _src_path)

try:
    from sshpilot.mcp.runtime.server import main
except ImportError as error:
    print(f"Error: {error}", file=sys.stderr)
    print(
        "sshpilot-mcp-runtime requires the 'mcp' SDK; install the optional extra: "
        "pip install 'sshpilot[mcp]'",
        file=sys.stderr,
    )
    sys.exit(1)

if __name__ == "__main__":
    sys.exit(main())
